{
  "navigationFallback": {
    "rewrite": "/landing.html",
    "exclude": ["/*.js", "/*.css", "/*.jpg", "/*.png", "/*.ico", "/*.sql", "/*.md"]
  },
  "routes": [
    { "route": "/",          "rewrite": "/landing.html"   },
    { "route": "/game",      "rewrite": "/index.html"     },
    { "route": "/contra",    "rewrite": "/contra.html"    },
    { "route": "/dashboard", "rewrite": "/dashboard.html" }
  ],
  "globalHeaders": {
    "Cache-Control": "no-cache, no-store, must-revalidate",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".html": "text/html",
    ".js":   "text/javascript",
    ".css":  "text/css",
    ".jpg":  "image/jpeg",
    ".png":  "image/png"
  }
}
