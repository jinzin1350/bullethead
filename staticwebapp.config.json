{
  "navigationFallback": {
    "rewrite": "/landing.html",
    "exclude": [
      "/pz-core.js",
      "/pz-ui.js",
      "/*.js",
      "/*.css",
      "/*.jpg",
      "/*.png",
      "/*.sql",
      "/*.md"
    ]
  },
  "routes": [
    {
      "route": "/",
      "rewrite": "/landing.html"
    },
    {
      "route": "/game",
      "rewrite": "/index.html"
    },
    {
      "route": "/contra",
      "rewrite": "/contra.html"
    },
    {
      "route": "/dashboard",
      "rewrite": "/dashboard.html"
    },
    {
      "route": "/dashboard.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/pz-core.js",
      "rewrite": "/pz-core.js"
    },
    {
      "route": "/pz-ui.js",
      "rewrite": "/pz-ui.js"
    }
  ],
  "globalHeaders": {
    "Cache-Control": "no-cache, no-store, must-revalidate",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".html": "text/html",
    ".js":   "text/javascript",
    ".css":  "text/css",
    ".jpg":  "image/jpeg",
    ".png":  "image/png"
  }
}
